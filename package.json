{
  "name": "hilatech-knowledge-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @hks/web dev",
    "build": "pnpm --filter @hks/web build",
    "start": "pnpm --filter @hks/web start",
    "lint": "pnpm --filter @hks/web lint",
    "typecheck": "pnpm -r typecheck",
    "qa:visual": "pnpm --filter @hks/web qa:visual",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "db:migrate": "pnpm --filter @hks/database migrate",
    "services:start": "bash scripts/dev-services.sh start",
    "services:stop": "bash scripts/dev-services.sh stop",
    "demo:seed": "tsx scripts/seed-demo.mts",
    "evaluate": "tsx scripts/evaluate.mts",
    "check:readiness": "tsx scripts/check-readiness.mts",
    "reindex": "tsx scripts/reindex-documents.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
