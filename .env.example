# HilaTech Knowledge Studio — environment variables
# Copy to apps/web/.env.local for local development. Never commit real values.
# The full reference, including variables for the functional milestone
# (database, Redis, storage, auth, LLM and embeddings providers), is in
# docs/DEPLOYMENT.md. Only the variables below are read by the code today.

# Where demo requests from the contact form are stored.
#   file  -> appended to LEADS_FILE as JSON lines (default in development)
#   none  -> the API answers 503 not_configured and the form shows an error
#            (default outside development, until the database store exists)
LEADS_STORE=file
LEADS_FILE=.data/leads.jsonl

# Number of reverse proxies you operate in front of the app (load balancer,
# CDN). Only that many entries at the END of X-Forwarded-For are trusted when
# resolving the client address for rate limiting. 0 = ignore the header.
TRUSTED_PROXY_HOPS=0

# --- Planned for the functional milestone (not read yet) ---------------------
# LLM_PROVIDER=anthropic            # anthropic | bedrock | deterministic
# LLM_MODEL_ID=                     # set per environment; see docs/DEPLOYMENT.md
# ANTHROPIC_API_KEY=                # development only; keep out of the repo
# EMBEDDINGS_PROVIDER=bedrock-cohere
# EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
# EMBEDDINGS_DIMENSIONS=1024
# DATABASE_URL=
# REDIS_URL=
