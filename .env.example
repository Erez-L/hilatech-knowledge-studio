# HilaTech Knowledge Studio — environment variables
# Copy to apps/web/.env.local (the worker and the scripts read the same names
# from the process environment). Never commit real values; never paste secrets
# into chat or issues. Read and validated by packages/shared/src/config.ts.
# `pnpm check:readiness` inspects a production configuration without calling
# any paid service.

APP_ENV=development              # development | test | demo | production
APP_BASE_URL=http://localhost:3000

# --- Database and queue -----------------------------------------------------
# Application role (subject to row-level security) and owner role (migrations only).
DATABASE_URL=postgres://hks_app:hks_app_dev@localhost:5432/hks_dev
DATABASE_MIGRATION_URL=postgres://hks_owner:hks_owner_dev@localhost:5432/hks_dev
REDIS_URL=redis://localhost:6380/0

# Number of reverse proxies you operate in front of the app (load balancer,
# CDN). Only that many entries at the END of X-Forwarded-For are trusted when
# resolving the client address for rate limiting. 0 = ignore the header.
TRUSTED_PROXY_HOPS=0

# --- Authentication (Better Auth) -------------------------------------------
# Required for sign-in and for the public demo's signed visitor cookie.
# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_SIGNUP_ENABLED=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Minutes without a request after which a signed-in session ends.
AUTH_SESSION_IDLE_MINUTES=60
LIMIT_AUTH_ATTEMPTS_PER_MINUTE=10

# --- Email (verification and password reset) --------------------------------
#   file -> written to MAIL_OUTBOX_FILE as JSON lines; nothing is sent. Development only, refused in production.
#   smtp -> sent through SMTP_URL
#   ses  -> sent through Amazon SES with the AWS default credentials (instance role); needs AWS_REGION or SES_REGION
#           and a MAIL_FROM on a domain verified in SES. In the SES sandbox only verified recipients get mail.
#   none -> mail is not configured; sign-up says so
MAIL_TRANSPORT=file
MAIL_OUTBOX_FILE=.data/mail/outbox.jsonl
MAIL_FROM="HilaTech Knowledge Studio <no-reply@localhost>"
# SMTP_URL=smtps://user:password@smtp.example.com:465

# --- Document storage (always private) --------------------------------------
STORAGE_DRIVER=local             # local | s3
STORAGE_LOCAL_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=

# --- AI providers -----------------------------------------------------------
# "none" means not configured: the app says so and never fakes output.
#   LLM_PROVIDER:        none | anthropic | bedrock | deterministic
#   EMBEDDINGS_PROVIDER: none | bedrock-cohere | deterministic
# "deterministic" is a TEST DOUBLE, not AI. It needs SAMPLE_MODE=true outside
# tests, is refused in production, and everything it produces is labelled.
LLM_PROVIDER=none
EMBEDDINGS_PROVIDER=none
SAMPLE_MODE=false
# LLM_MODEL_ID=                   # the only place a chat model ID is set
# LLM_MAX_OUTPUT_TOKENS=1024
# ANTHROPIC_API_KEY=              # development only
# AWS_REGION=                     # Bedrock uses the standard AWS credential chain; no keys here in production
# BEDROCK_REGION=                 # if different from AWS_REGION
# EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
# EMBEDDINGS_DIMENSIONS=1024

# --- Retrieval (placeholders until calibrated with real embeddings) ---------
# CHUNK_TARGET_CHARS=1200
# CHUNK_MAX_CHARS=1800
# CHUNK_OVERLAP_CHARS=200
# RAG_TOP_K=12
# RAG_MAX_CONTEXT_CHUNKS=6
# Earlier question/answer pairs used for a follow-up question (0 turns it off, at most 5).
# RAG_HISTORY_TURNS=3
# RAG_MIN_SIMILARITY=0.3
# RAG_EVIDENCE_MIN_SIMILARITY=0.4

# --- Limits and budgets ------------------------------------------------------
# UPLOAD_MAX_BYTES=20971520
# UPLOAD_MAX_PAGES=300
# LIMIT_UPLOADS_PER_MINUTE=10
# LIMIT_UPLOADS_PER_DAY=50
# LIMIT_QUESTIONS_PER_MINUTE=10
# LIMIT_QUESTIONS_PER_DAY=200
# BUDGET_DAILY_INPUT_TOKENS=2000000
# BUDGET_DAILY_OUTPUT_TOKENS=200000

# --- Public demo (/demo) ------------------------------------------------------
# Anonymous, read-only, limited to the fictional Northstar documents. It is live
# only after `pnpm demo:seed`; until then /demo shows the scripted preview.
# The per-day number caps what the demo can spend on model calls.
DEMO_ENABLED=true
LIMIT_DEMO_QUESTIONS_PER_MINUTE=4      # per client address
LIMIT_DEMO_QUESTIONS_PER_SESSION=15    # per visitor, per 24 hours
LIMIT_DEMO_QUESTIONS_PER_DAY=300       # all visitors together

# --- Contact form leads -------------------------------------------------------
#   postgres -> contact_leads table (default when DATABASE_URL is set)
#   file     -> appended to LEADS_FILE as JSON lines (development)
#   none     -> the API answers 503 and the form shows an error
# LEADS_STORE=postgres
# LEADS_FILE=.data/leads.jsonl

# --- Scanned PDF pages (OCR through a vision model) ---------------------------
#   none          -> scanned PDFs are reported as unsupported
#   tesseract     -> the local Tesseract engine reads each such page (OCR_LANGUAGES, default heb+eng); free, no network
#   bedrock       -> each page without a text layer is read by OCR_MODEL_ID (default: LLM_MODEL_ID); every page is a paid call
#   deterministic -> test double, does not read the image
OCR_PROVIDER=none
# OCR_MODEL_ID=
OCR_MAX_PAGES=20
# OCR_LANGUAGES=heb+eng
OCR_MAX_OUTPUT_TOKENS=16000
