# HilaTech Knowledge Studio — environment variables
# Copy to apps/web/.env.local for local development. Never commit real values.
# The full reference, including variables for the functional milestone
# (database, Redis, storage, auth, LLM and embeddings providers), is in
# docs/DEPLOYMENT.md. Only the variables below are read by the code today.

# Where demo requests from the contact form are stored.
#   file  -> appended to LEADS_FILE as JSON lines (default in development)
#   none  -> the API answers 503 not_configured and the form shows an error
#            (default outside development, until the database store exists)
LEADS_STORE=file
LEADS_FILE=.data/leads.jsonl

# Number of reverse proxies you operate in front of the app (load balancer,
# CDN). Only that many entries at the END of X-Forwarded-For are trusted when
# resolving the client address for rate limiting. 0 = ignore the header.
TRUSTED_PROXY_HOPS=0

# --- Milestone 2: database, queue, storage, providers ---------------------
# Read by packages/shared/src/config.ts. See docs/DEPLOYMENT.md for the full list.
APP_ENV=development

# Application role (subject to row-level security) and owner role (migrations only).
DATABASE_URL=postgres://hks_app:hks_app_dev@localhost:5432/hks_dev
DATABASE_MIGRATION_URL=postgres://hks_owner:hks_owner_dev@localhost:5432/hks_dev
REDIS_URL=redis://localhost:6380/0

STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=

# Providers. "none" means not configured: the app says so and never fakes output.
#   LLM_PROVIDER:        none | anthropic | bedrock | deterministic
#   EMBEDDINGS_PROVIDER: none | bedrock-cohere | deterministic
# "deterministic" is a TEST DOUBLE, not AI. It needs SAMPLE_MODE=true, is refused
# in production, and everything it produces is labelled as sample output.
LLM_PROVIDER=none
EMBEDDINGS_PROVIDER=none
SAMPLE_MODE=false
# LLM_MODEL_ID=                   # the only place a chat model ID is set
# ANTHROPIC_API_KEY=              # development only; never commit
# AWS_REGION=
# EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
# EMBEDDINGS_DIMENSIONS=1024
