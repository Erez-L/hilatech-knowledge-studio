# /opt/knowledge-studio/.env on the host. chmod 600. Never commit the real file.
# Lines marked GENERATE are produced on the host (see docs/DEPLOYMENT_SINGLE_HOST.md);
# they are never typed into a chat, a ticket or a commit.

# --- Compose ---------------------------------------------------------------
IMAGE_REPOSITORY=erez-l/hilatech-knowledge-studio
IMAGE_TAG=v0.1.0
EDGE_NETWORK=hilatech-ai-assistant_default
POSTGRES_SUPERUSER_PASSWORD=GENERATE
HKS_OWNER_PASSWORD=GENERATE
HKS_APP_PASSWORD=GENERATE

# --- Application -----------------------------------------------------------
APP_ENV=demo
APP_BASE_URL=https://knowledge.hilatechdev.com
DATABASE_URL=postgres://hks_app:<HKS_APP_PASSWORD>@ks-postgres:5432/hks
DATABASE_MIGRATION_URL=postgres://hks_owner:<HKS_OWNER_PASSWORD>@ks-postgres:5432/hks
REDIS_URL=redis://ks-redis:6379/0
# One proxy (Caddy) in front of the app. Use 2 if Cloudflare proxies the record as well.
TRUSTED_PROXY_HOPS=1
AUTH_SECRET=GENERATE
AUTH_SIGNUP_ENABLED=false
# none -> sign-up stays closed. ses -> Amazon SES through the instance role (no stored credentials).
MAIL_TRANSPORT=none
# MAIL_TRANSPORT=ses
# MAIL_FROM="HilaTech Knowledge Studio <no-reply@hilatechdev.com>"

STORAGE_DRIVER=s3
S3_BUCKET=hilatech-knowledge-studio-docs-590184083649
AWS_REGION=us-east-1

LLM_PROVIDER=bedrock
LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
EMBEDDINGS_PROVIDER=bedrock-cohere
EMBEDDINGS_MODEL_ID=cohere.embed-multilingual-v3
SAMPLE_MODE=false
# Scanned PDF pages are read by the chat model (one paid call per page). none switches it off.
OCR_PROVIDER=bedrock
OCR_MAX_PAGES=20

RAG_MIN_SIMILARITY=0.4
RAG_EVIDENCE_MIN_SIMILARITY=0.5
DEMO_ENABLED=true
